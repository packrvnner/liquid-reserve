# Keeper wallet: a dedicated hot wallet holding only gas (HYPE on Elysium and HyperEVM).
# It must be set as an oracle keeper (DeploySystem's KEEPER). Never use a wallet that holds funds.
KEEPER_PRIVATE_KEY=

# For DRY_RUN=1 without a key: the address to simulate as.
KEEPER_ADDRESS=

# Optional overrides
# KEEPER_CONFIG=keeper.config.json
# KEEPER_STATE=keeper.state.json
# ELYSIUM_RPC=
# HYPEREVM_RPC=
# ALERT_WEBHOOK_URL=   # Discord/Slack-style webhook for alerts
# DRY_RUN=1
